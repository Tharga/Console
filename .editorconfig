root = true

[*.cs]

# Private static readonly fields hold values that are conceptually constants but
# cannot be declared `const` (TimeSpan, arrays, …). They are named in PascalCase
# so they read alongside the real `const` members rather than looking like
# mutable instance state.
dotnet_naming_rule.static_readonly_fields_are_pascal_case.severity = suggestion
dotnet_naming_rule.static_readonly_fields_are_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal_case.style = pascal_case

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static,readonly

dotnet_naming_style.pascal_case.capitalization = pascal_case

# Test classes are named as sentences on purpose — `With_command_line`,
# `When_writing_a_line`, `When_running_in_parallel` — because the class name is
# the "given" half of the test description and reads directly in the runner
# output. Their fields follow the same relaxed style. ReSharper's default rules
# want PascalCase types and _camelCase fields, which would destroy that.
[**/*.Tests/**.cs]
resharper_inconsistent_naming_highlighting = none

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Public EventArgs and configuration types. Consumers of the packages read and set
# these properties, which ReSharper cannot see from inside this solution, so its
# `.Global` accessor inspection is a false positive here.
[Tharga.Console.Standard/Entities/**.cs]
resharper_unused_auto_property_accessor_global_highlighting = none

[Tharga.Console.Speech/Commands/VoiceConsoleConfiguration.cs]
resharper_unused_auto_property_accessor_global_highlighting = none

# The explicit `QueryParam<T>` type arguments are deliberate. Nine overloads differ
# only by the options collection type, and the explicit `<T>` guards against a
# future overload-resolution surprise.
[Tharga.Console.Standard/Extensions/QueryInputExtension.cs]
resharper_redundant_type_arguments_of_method_highlighting = none

# The extension classes live in the root `Tharga.Console` namespace on purpose, so
# consumers get them without an extra `using`. Moving them to match the folder
# would break every consumer, so the folder and namespace stay different.
[Tharga.Console.Standard/Extensions/**.cs]
resharper_check_namespace_highlighting = none
